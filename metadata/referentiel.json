  "Regles": [
    {
      "REGLE_ID": "R001",
      "NOM_REGLE": "Contrat_Reference_Non_Nulle",
      "DESCRIPTION": "La référence du contrat ne doit pas être nulle",
      "EXPRESSION_SQL": "SELECT * FROM CONTRACT WHERE REFERENCE IS NULL"
    },
    {
      "REGLE_ID": "R002",
      "NOM_REGLE": "Client_Prenom_Non_Nul",
      "DESCRIPTION": "Le prénom du client ne doit pas être nul",
      "EXPRESSION_SQL": "SELECT * FROM CUSTOMER WHERE FIRST_NAME IS NULL"
    },
    {
      "REGLE_ID": "R003",
      "NOM_REGLE": "Client_Email_Valide",
      "DESCRIPTION": "L'email du client doit être valide",
      "EXPRESSION_SQL": "SELECT * FROM CUSTOMER WHERE EMAIL NOT LIKE '%@%.%'"
    },
    {
      "REGLE_ID": "R004",
      "NOM_REGLE": "Plaque_Immatriculation_Non_Nulle",
      "DESCRIPTION": "La plaque d'immatriculation ne doit pas être nulle",
      "EXPRESSION_SQL": "SELECT * FROM FLEETVEHICLE WHERE LICENSE_PLATE IS NULL"
    },
    {
      "REGLE_ID": "R005",
      "NOM_REGLE": "Montant_Contrat_Positif",
      "DESCRIPTION": "Le montant du contrat doit être positif",
      "EXPRESSION_SQL": "SELECT * FROM CONTRACT WHERE AMOUNT < 0"
    },
    {
      "REGLE_ID": "R006",
      "NOM_REGLE": "Date_Fin_Apres_Debut",
      "DESCRIPTION": "La date de fin doit être après la date de début",
      "EXPRESSION_SQL": "SELECT * FROM CONTRACT WHERE END_DATE < START_DATE"
    },
    {
      "REGLE_ID": "R007",
      "NOM_REGLE": "VIN_Unique",
      "DESCRIPTION": "Le VIN doit être unique",
      "EXPRESSION_SQL": "SELECT VIN, COUNT(*) FROM FLEETVEHICLE GROUP BY VIN HAVING COUNT(*) > 1"
    },
    {
      "REGLE_ID": "R008",
      "NOM_REGLE": "Client_Nom_Complet_Non_Nul",
      "DESCRIPTION": "Le nom complet du client ne doit pas être nul",
      "EXPRESSION_SQL": "SELECT * FROM CUSTOMER WHERE FIRST_NAME IS NULL OR LAST_NAME IS NULL"
    }
  ],
